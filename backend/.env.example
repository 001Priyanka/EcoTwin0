# AWS Deployment & Region Configuration
AWS_REGION=ap-south-1

# Deployment Environment Stage (dev | staging | prod)
ENVIRONMENT_STAGE=dev

# DynamoDB Table Name (matches SAM template naming convention: ecotwin-zones-${ENVIRONMENT_STAGE})
ZONES_TABLE_NAME=ecotwin-zones-dev

# Optional local DynamoDB endpoint for offline / container development (DynamoDB Local)
# Uncomment when running against local DynamoDB on port 8000
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_ENDPOINT_URL=http://localhost:8000

# Seeding Safety Guard (set to true only when explicitly seeding a production table)
ALLOW_PROD_SEED=false
