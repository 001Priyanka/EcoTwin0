# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EcoTwin Geospatial Map Configuration
# Configurable MapLibre GL JS vector style URL.
# Uses OpenFreeMap Dark style by default.
VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/dark"
# EcoTwin Environmental Intelligence API Configuration
# Base URL for the EcoTwin REST backend service (e.g. http://localhost:3000 or /api proxy)
VITE_API_BASE_URL="http://localhost:3001"

# Demo Mode Flag: When "true", enables standalone execution with verified simulated fixtures
# Set to "false" to connect exclusively to the live backend service.
VITE_DEMO_MODE="true"
