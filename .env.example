# EcoTwin — Kolhapur Frontend Environment Variables
# Copy this file to .env.local for local development.
# For AWS deployment, set these in your hosting service (Amplify / S3+CloudFront CI/CD).

# Base URL of the deployed API Gateway (from SAM deploy output: EcoTwinApiUrl).
# Leave empty to run in demo mode (uses local mock data — no backend required).
VITE_API_BASE_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/dev

# Set to "true" to force demo/offline mode even when VITE_API_BASE_URL is set.
# Set to "false" to force live mode. Leave unset to auto-detect from VITE_API_BASE_URL.
VITE_DEMO_MODE=false

# MapLibre GL map style URL (dark theme default shown below).
# OpenFreeMap is free and requires no API key.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
